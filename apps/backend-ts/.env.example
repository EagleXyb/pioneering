# Database（与 Python 版共用同一数据库，表结构由 Python 版 init_db 创建）
DATABASE_URL=postgresql://postgres:root@localhost:5432/pioneering

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRATION_HOURS=2
REFRESH_TOKEN_EXPIRATION_DAYS=30

# AI / LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-flash
# 深度思考模型（deepThink 开关使用）
LLM_REASONING_MODEL=deepseek-v4-pro
# 流式空闲超时（毫秒；只在不产生任何数据时中止，不限制总时长）
LLM_STREAM_IDLE_TIMEOUT_MS=60000
# P1：LLM 网关开关（0 / false / off 时回落到旧直连实现，用于紧急回滚）
LLM_GATEWAY_ENABLED=1
# P5：密钥来源。env=读下面的 LLM_API_KEY；file=读 JSON 密钥文件（推荐 chmod 600）
SECRET_PROVIDER=env
# file provider 使用；留空默认 ~/.pioneering/llm-secrets.json
# 文件格式：{"apiKey":"...","baseUrl":"https://api.deepseek.com/v1"}
LLM_SECRET_FILE=
# P4：分层限流（每分钟请求数；0 = 不限制）
RATE_LIMIT_USER_RPM=60
RATE_LIMIT_MODEL_RPM=120

# Server
HOST=0.0.0.0
# P1-10 修复：8088 避开 Chromium 不安全端口黑名单（6000 是 X11 端口）
PORT=8088
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_DIR=./logs
