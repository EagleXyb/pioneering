# Database（与 Python 版共用同一数据库，表结构由 Python 版 init_db 创建）
DATABASE_URL=postgresql://postgres:root@localhost:5432/pioneering

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRATION_HOURS=2
REFRESH_TOKEN_EXPIRATION_DAYS=30

# AI / LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-chat

# Server
HOST=0.0.0.0
# P1-10 修复：8088 避开 Chromium 不安全端口黑名单（6000 是 X11 端口）
PORT=8088
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_DIR=./logs
