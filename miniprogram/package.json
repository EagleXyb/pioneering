{
  "name": "miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "创路 Agent - AI 驱动的创意孵化与创新探索小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "npx taro build --type weapp && node scripts/fix-icon-font.mjs",
    "fix:icon-font": "node scripts/fix-icon-font.mjs",
    "dev:weapp": "npx taro build --type weapp --watch",
    "build:swan": "npx taro build --type swan",
    "dev:swan": "npx taro build --type swan --watch",
    "build:alipay": "npx taro build --type alipay",
    "dev:alipay": "npx taro build --type alipay --watch",
    "build:tt": "npx taro build --type tt",
    "dev:tt": "npx taro build --type tt --watch",
    "build:h5": "npx taro build --type h5",
    "dev:h5": "npx taro build --type h5 --watch",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/plugin-platform-alipay": "4.0.9",
    "@tarojs/plugin-platform-h5": "4.0.9",
    "@tarojs/plugin-platform-swan": "4.0.9",
    "@tarojs/plugin-platform-tt": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "@tdesign-react/chat": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdesign-miniprogram": "^1.14.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-taro": "4.0.9",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.0.9",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "sass": "^1.77.0",
    "typescript": "5.1.6",
    "webpack": "^5.91.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
