generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  location  String?
  bio       String?
  company   String?
  position  String?
  joinDate  DateTime @default(now())
  skills    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
