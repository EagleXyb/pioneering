generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  location  String?
  bio       String?
  company   String?
  position  String?
  joinDate  DateTime @default(now())
  skills    String[]
  avatar    String?  // 存储头像的base64编码
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIConfig {
  id        Int      @id @default(autoincrement())
  apiKey    String
  provider  String
  model     String
  prompt    String
  lastTestInput    String?
  lastTestResult   String?
  lastTestTime     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([provider, model])
}
