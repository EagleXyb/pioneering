page {
  background-color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.47059;
}

.container {
  padding: 32rpx;
}

.text-primary {
  color: #1d1d1f;
}

.text-secondary {
  color: #86868b;
}

.bg-primary {
  background-color: #ffffff;
}

.bg-secondary {
  background-color: #f5f5f7;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2490f8;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary::after {
  border: none;
}
