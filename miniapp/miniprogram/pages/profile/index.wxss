.page {
  background: #f5f5f7;
  min-height: 100vh;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background: #ffffff;
}

.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.user-email {
  font-size: 26rpx;
  color: #86868b;
  margin-top: 8rpx;
}

.profile-section {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 24rpx 32rpx;
  overflow: hidden;
}

.section-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8ed;
}

.section-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 28rpx;
  color: #86868b;
}

.item-value {
  font-size: 28rpx;
  color: #1d1d1f;
}
