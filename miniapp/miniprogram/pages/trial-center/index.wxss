.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
}

.project-selector {
  display: flex;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #e8e8ed;
}

.project-option {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #86868b;
  margin-right: 16rpx;
}

.project-option.active {
  background: #2490f8;
  color: #ffffff;
}

.chat-area {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.empty-hint {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.empty-text {
  color: #86868b;
  font-size: 28rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #e8e8ed;
  background: #ffffff;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f7;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: #2490f8;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 28rpx;
}
