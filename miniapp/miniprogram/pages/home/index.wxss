.page {
  padding: 32rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 48rpx;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 28rpx;
  color: #86868b;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 8rpx;
}

.avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
}

.features {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.feature-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.feature-info {
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.feature-desc {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 4rpx;
}
