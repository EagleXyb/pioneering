.page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f5f5f7;
}

.login-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.subtitle {
  font-size: 26rpx;
  color: #86868b;
  margin-top: 12rpx;
  margin-bottom: 48rpx;
}

.form {
  width: 100%;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.wx-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-login-btn::after {
  border: none;
}
